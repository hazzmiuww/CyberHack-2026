# Auto detect text files and perform LF normalization
* text=auto

# Windows batch files should always use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell scripts should use CRLF
*.ps1 text eol=crlf

# Shell scripts should use LF
*.sh text eol=lf

# Python files should use LF
*.py text eol=lf

# JavaScript/TypeScript files
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf

# JSON files
*.json text eol=lf

# Markdown files
*.md text eol=lf

# Binary files
*.pt binary
*.mp4 binary
*.db binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
